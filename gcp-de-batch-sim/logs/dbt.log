    FROM `gcp-de-batch-sim-464816-476514`.`Employee_Details_stg`.`Employee_stg`
),

department AS (
    SELECT
        DepartmentID,
        Name AS DepartmentName,
        GroupName
    FROM `gcp-de-batch-sim-464816-476514`.`Employee_Details_stg`.`Department_stg`
)

SELECT
    e.BusinessEntityID,
    e.LoginID,
    e.NationalIDNumber,
    e.JobTitle,
    e.BirthDate,
    e.Gender,
    e.HireDate,
    e.SalariedFlag,
    e.VacationHours,
    e.SickLeaveHours,
    e.CurrentFlag,
